{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "DATABASE_URL",
        "DIRECT_URL",
        "SMTP_USER",
        "SMTP_PASS",
        "JWT_SECRET",
        "NEXT_PUBLIC_APP_NAME",
        "NEXT_PUBLIC_CITY_LOCK"
      ],
      "outputs": [".next/**", "!**/.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    }
  }
}
